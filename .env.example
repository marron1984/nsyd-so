# ── Claude API（AI 自動返信） ──────────────────────────────
# https://console.anthropic.com/ で取得した API キー
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend（メール送信） ───────────────────────────────────
# https://resend.com/ で取得した API キー
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 送信元アドレス（Resend で認証済みドメインのアドレスを指定）
# 例: 西淀川いいかいご相談ダイヤル <info@example.com>
MAIL_FROM="西淀川いいかいご相談ダイヤル <onboarding@resend.dev>"

# 問い合わせ通知の受信先（相談窓口の担当者アドレス。カンマ区切りで複数可）
MAIL_TO=staff@example.com

# 任意: AI 自動返信を無効化して保存・通知のみ行う場合は false
AI_AUTO_REPLY_ENABLED=true
